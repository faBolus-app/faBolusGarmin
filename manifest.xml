<?xml version="1.0" encoding="UTF-8"?>
<!-- faBolus Garmin watch app. This id is the one the iOS app targets by default
     (GARMIN_BETA_APP_ID in faBolus's Config.xcconfig); scripts/beta-build.sh swaps in a personal id
     for a private beta. Phone-relay only; no BLE permission. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="FaBolusApp"
                    id="a1b2c3d4e5f600112233445566778899"
                    launcherIcon="@Drawables.LauncherIcon"
                    name="@Strings.AppName"
                    type="watch-app"
                    minSdkVersion="5.1.0">
        <iq:products>
            <!-- Touchscreen watches. venu3s is hardware-validated (the sole supported device). -->
            <iq:product id="venu3s"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="ComplicationPublisher"/>
            <iq:uses-permission id="Background"/>
            <!-- Notifications.showNotification(), from the background service, so an alert the phone
                 marks "alert" isn't silent on the wrist while the app is closed. -->
            <iq:uses-permission id="Notifications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
