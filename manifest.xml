<?xml version="1.0" encoding="UTF-8"?>
<!-- faBolus Garmin watch app — BETA store listing. This is the second/experimental copy; the
     OFFICIAL listing is manifest-official.xml (a distinct app id). This id is the one the iOS
     ConnectIQ bridge currently targets (GarminRemoteBridge.watchAppUUID). Phone-relay only; no
     BLE permission. Direct-to-pump is not in this tree. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="FaBolusApp"
                    id="a1b2c3d4e5f600112233445566778899"
                    launcherIcon="@Drawables.LauncherIcon"
                    name="@Strings.AppNameBeta"
                    type="watch-app"
                    minSdkVersion="5.1.0">
        <iq:products>
            <!-- Touchscreen watches. venu3s is hardware-validated (the sole supported device). -->
            <iq:product id="venu3s"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="ComplicationPublisher"/>
            <iq:uses-permission id="Background"/>
            <!-- Notifications.showNotification(), from the background service, so an alert the phone
                 marks "alert" isn't silent on the wrist while the app is closed. -->
            <iq:uses-permission id="Notifications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
