# Connect IQ build config for the shipping faBolus Garmin remote (phone-relay).
# Build:  monkeyc -f monkey.jungle -o bin/faBolus.iq -y <dev_key.der> -e -r -w
#
# Portability: the app auto-adapts to the device at runtime (touch vs buttons, screen shape) via
# DeviceProfile, so supporting a new watch is usually just adding its <iq:product> to manifest.xml.
#
# Complications are watch-only. The complication resource lives in resources-complications/ and is
# included for all devices by default; a device without a watch face (e.g. a cycling computer) would
# need to drop it via a `<device>.resourcePath = resources` line — moot for the current venu3s-only
# shipping target, which has a watch face and keeps the complication.
#
# NARROW-MAIN (2026-08-27): the paused direct-pump + direct-cgm BLE engines have been REMOVED from main
# (never part of any shipping build); they live on the dev/direct-ble + experimental branches only.
project.manifest = manifest.xml
# G-L4 (19-03): pin an explicit type check level rather than relying on the compiler's implicit default
# (Gradual). Level 2 (Informative) is the highest level this codebase currently compiles clean at without
# errors — Level 3 (Strict) currently fails with 400+ pre-existing errors across the app + tests
# (untyped params/members, PolyType-vs-Object parameter mismatches), all pre-dating this plan and well
# outside its scope. See 19-03-SUMMARY.md for the full compile matrix.
project.typecheck = 2
# The build-commit stamp (source/generated/AppRevision.mc) that the Details "App:" row displays. It is
# GENERATED by scripts/stamp-revision.sh before every compile and git-ignored, because a commit's hash is
# a function of its own contents and so cannot be stored in that same commit without being stale. Every
# build entry point here runs the generator first; a bare `monkeyc` that skips it fails to compile on the
# missing AppRevision symbol, which is the intended fail-closed behaviour — an unstamped binary is fine,
# a binary stamped with the WRONG tree is not.
base.sourcePath = source/app;source/generated
base.resourcePath = resources;resources-complications
# Default build keeps the real complication publisher; drop the no-op stub (see BgComplication.mc).
base.excludeAnnotations = nocomplications
