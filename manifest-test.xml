<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest for UNIT-TEST builds only (test.jungle). Uses a minimal entry (TestEntryApp) so the
     test harness isn't blocked by the real app's background/timer lifecycle. Not shipped. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="TestEntryApp"
                    id="7f3c1b2a9d6e4f5081a2b3c4d5e6f708"
                    launcherIcon="@Drawables.LauncherIcon"
                    name="@Strings.AppName"
                    type="watch-app"
                    minSdkVersion="5.1.0">
        <iq:products>
            <iq:product id="venu3s"/>
        </iq:products>
        <!-- Only what the app + shared resources need: ComplicationPublisher for the complications
             resource, Communications for RemoteComm.mc (compiled in with AppState.mc for the E5 parse
             tests). NARROW-MAIN (2026-08-27): BluetoothLowEnergy is GONE — it existed only for the paused
             direct-pump BLE client, now removed from main (lives on dev/direct-ble + experimental).
             CX-G-12 (13-04): Sensor is required by the EatingSenseKit barrel (mirrors manifest.xml) now
             that EatingRelay.mc is compiled into the test binary — monkeyc refuses to link the barrel
             into a project that doesn't declare the permission it depends on. -->
        <iq:permissions>
            <iq:uses-permission id="ComplicationPublisher"/>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
            <!-- CX-G-12 (13-04): FaBolusApp.mc/BgService.mc are now compiled into the test binary and
                 declare a (:background) ServiceDelegate — the compiler requires this permission whenever
                 a background application (any (:background)-annotated class) is present. Mirrors
                 manifest.xml. This is a compile-time requirement only; the test entry (TestEntryApp)
                 never actually registers a temporal event. -->
            <iq:uses-permission id="Background"/>
            <!-- CX-G-06 (13-07): BgService.mc now calls Toybox.Notifications.showNotification() from the
                 (:background) BgServiceDelegate — mirrors manifest.xml/manifest-official.xml. -->
            <iq:uses-permission id="Notifications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <!-- CX-G-12 (13-04): EatingRelay.mc (`using EatingSenseKit;`) is now compiled into the test
             binary — see test.jungle's base.barrelPath. Mirrors manifest.xml. -->
        <iq:barrels>
            <iq:depends name="EatingSenseKit" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
