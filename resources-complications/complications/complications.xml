<complications>
    <!-- The glucose complication. It publishes the reading as a number (a string :value reads as 0 on a
         ranged face) with an ASCII trend arrow as its :unit, and "124 ^" as its label, for a face that shows
         text. A stale reading is published as no value and a label of two dashes. The range is the glucose
         bands in mg/dL (low, in range, high, very high) and can't follow the user's unit, so with mmol/L
         only the label is published, never a number the bands would colour wrongly. -->
    <complication id="0" access="public"
                  longLabel="@Strings.ComplicationLong"
                  shortLabel="@Strings.ComplicationShort"
                  icon="@Drawables.BgComplicationIcon"
                  glancePreview="true">
        <faceIt defaultText="@Strings.ComplicationFaceIt" />
        <range>
            <value>0</value>
            <value>70</value>
            <value>180</value>
            <value>250</value>
            <value>400</value>
        </range>
    </complication>

    <!-- Three pump-status slots, display only: an app may publish four complications, and glucose is the
         first. The phone's setting chooses which of IOB, reservoir, battery and basal fill them, in order
         (BgComplication.slot). The long label is the slot's number, because the face's menu can't show the
         runtime choice; the short label names the value unless the user turned names off. No range: these
         aren't coloured like glucose. glancePreview is allowed on one complication, the glucose one. -->
    <complication id="1" access="public"
                  longLabel="@Strings.ComplicationSlot1Long"
                  shortLabel="@Strings.ComplicationSlot1Short"
                  icon="@Drawables.BgComplicationIcon">
        <faceIt defaultText="@Strings.ComplicationSlot1FaceIt" />
    </complication>
    <complication id="2" access="public"
                  longLabel="@Strings.ComplicationSlot2Long"
                  shortLabel="@Strings.ComplicationSlot2Short"
                  icon="@Drawables.BgComplicationIcon">
        <faceIt defaultText="@Strings.ComplicationSlot2FaceIt" />
    </complication>
    <complication id="3" access="public"
                  longLabel="@Strings.ComplicationSlot3Long"
                  shortLabel="@Strings.ComplicationSlot3Short"
                  icon="@Drawables.BgComplicationIcon">
        <faceIt defaultText="@Strings.ComplicationSlot3FaceIt" />
    </complication>
</complications>
