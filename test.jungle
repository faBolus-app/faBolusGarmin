# The unit-test build: the whole app plus tests/ and the resources scripts/gen-test-resources.sh makes
# from contract/ (the golden fixtures and the bolus calculator rows). TestEntryApp is a minimal entry, so
# the app's timers and background registration don't run under the tests.
#   ./scripts/gen-test-resources.sh
#   monkeyc -f test.jungle -o bin/faBolusGarmin-test.prg -y developer_key.der -d venu3s --unit-test
#   monkeydo bin/faBolusGarmin-test.prg venu3s -t
#
# Strict type checking, as for the app.
project.typecheck = 3
project.manifest = manifest-test.xml
# source/generated holds the build-commit stamp (scripts/stamp-revision.sh), tests/generated the contract
# resources; both are generated before every compile and git-ignored.
base.sourcePath = source/app;source/generated;tests;tests/generated
base.resourcePath = resources;resources-complications;tests/generated
base.excludeAnnotations = nocomplications
